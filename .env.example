# Copia este archivo como .env y completa los valores de tu proyecto de Supabase
# (Supabase > Project Settings > API). El archivo .env nunca se sube ni se publica.

# URL del proyecto, por ejemplo https://abcdefgh.supabase.co
SUPABASE_URL=

# Clave pública (publishable / anon). Puede usarse en el navegador: RLS protege los datos.
SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (secret / service_role). Solo para el backend: salta RLS. Nunca en public/.
SUPABASE_SECRET_KEY=

# Puerto del servidor local (opcional)
PORT=3000

# === Sistema Multiagente / IA ===
# Credenciales autorizadas separadas por coma. El gateway aplica balanceo/fallback.
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_LLM_TEMPERATURE=0
AI_LLM_TIMEOUT_SECONDS=30
AI_PROVIDER_COOLDOWN_SECONDS=60

# Servicio RAG externo (opcional). Vacío = intenta LightRAG embebido; si no hay índice, usa fallback determinístico.
RAG_SERVICE_URL=

# Observabilidad opcional con LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=paciente-virtual-sma

# === RAG integrado en el mismo backend ===
# true = usa el índice LightRAG in-process cuando existe.
RAG_EMBEDDED=true
RAG_INDEX_DIR=data/indexes/lightrag
RAG_LOG_PATH=logs/rag_retrieval.jsonl
RAG_EMBEDDING_BACKEND=local_hash
RAG_HASH_EMBEDDING_DIMENSION=256
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# RAG_SERVICE_URL queda reservado para despliegue desacoplado.
# Si tiene valor, tiene prioridad sobre RAG_EMBEDDED.
