# Copia este archivo como .env y completa los valores de tu proyecto de Supabase
# (Supabase > Project Settings > API). El archivo .env nunca se sube ni se publica.

# URL del proyecto, por ejemplo https://abcdefgh.supabase.co
SUPABASE_URL=

# Clave pública (publishable / anon). Puede usarse en el navegador: RLS protege los datos.
SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (secret / service_role). Solo para el backend: salta RLS. Nunca en public/.
SUPABASE_SECRET_KEY=

# Fuente de los casos: local para preparacion/pruebas; supabase para la aplicacion.
# npm run import:cases activa supabase en .env tras verificar la carga.
CASE_STORE=local

# Completar historia ausente y persistirla: requiere CASE_STORE=supabase y Groq.
SYNTHETIC_CASE_DATA=false

# Puerto del servidor local (opcional)
PORT=3000

# === Sistema multiagente (backend/server/ai/) ===
# Claves de Groq separadas por coma; el gateway reparte y cambia de clave si una falla.
# Vacío = modo local: los agentes devuelven el texto exacto de la evidencia, sin LLM.
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_LLM_TEMPERATURE=0
AI_LLM_TIMEOUT_SECONDS=30
AI_PROVIDER_COOLDOWN_SECONDS=60
AI_TRACE_PATH=backend/logs/ai_traces.jsonl
# Dónde se guardan las consultas: memoria (desarrollo y pruebas) o supabase (despliegue, por ejemplo Vercel,
# donde cada petición puede atenderla otra instancia). supabase usa SUPABASE_URL y SUPABASE_SECRET_KEY y
# necesita las tablas de backend/supabase/migrations/0002_sesiones_sma.sql.
SESSION_STORE=memoria

# === RAG (backend/server/rag/) ===
# Servicio RAG externo (opcional). Si tiene valor, tiene prioridad sobre el RAG embebido.
RAG_SERVICE_URL=
# Token entre servicios para las búsquedas de /api/v1/rag. Vacío = esas rutas no se atienden
# (el SMA usa el RAG dentro del mismo proceso). El cliente lo envía en la cabecera X-RAG-Token.
RAG_HTTP_TOKEN=
# true = usa el índice LightRAG dentro del mismo servidor cuando existe; si no, usa el caso directamente.
RAG_EMBEDDED=true
RAG_INDEX_DIR=data/indexes/lightrag
RAG_LOG_PATH=backend/logs/rag_retrieval.jsonl
RAG_EMBEDDING_BACKEND=local_hash
RAG_HASH_EMBEDDING_DIMENSION=256
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Observabilidad opcional con LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=paciente-virtual-sma
