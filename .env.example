# Copia este archivo como .env y completa los valores de tu proyecto de Supabase
# (Supabase > Project Settings > API). El archivo .env nunca se sube ni se publica.

# URL del proyecto, por ejemplo https://abcdefgh.supabase.co
SUPABASE_URL=

# Clave pública (publishable / anon). Puede usarse en el navegador: RLS protege los datos.
SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (secret / service_role). Solo para el backend: salta RLS. Nunca en public/.
SUPABASE_SECRET_KEY=

# Puerto del servidor local (opcional)
PORT=3000
