# Copia este archivo como .env y completa los valores de tu proyecto de Supabase
# (Supabase > Project Settings > API). El archivo .env nunca se sube ni se publica.

# URL del proyecto, por ejemplo https://abcdefgh.supabase.co
SUPABASE_URL=

# Clave pública (publishable / anon). Puede usarse en el navegador: RLS protege los datos.
SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (secret / service_role). Solo para el backend: salta RLS. Nunca en public/.
SUPABASE_SECRET_KEY=

# Puerto del servidor local (opcional)
PORT=3000

# ---------------------------------------------------------------------------
# Variables que se usarán más adelante. Descoméntalas cuando el módulo exista
# y alinea los nombres con backend/server/config.py.
# ---------------------------------------------------------------------------

# Proveedor de LLM (pendiente: Groq / OpenRouter / Claude / Gemini) · backend/server/ai/llm/
# LLM_PROVIDER=
# LLM_MODEL=
# LLM_API_KEY=
# LLM_TEMPERATURE=0

# Embeddings y RAG · backend/server/ai/embeddings/, backend/server/rag/
# EMBEDDING_MODEL=
# VECTOR_STORE=

# Rutas de datos (por defecto, las carpetas del repositorio)
# CASES_DIR=data/cases/curated
# INDEX_DIR=data/indexes
# LOGS_DIR=backend/logs

# Observabilidad de agentes (opcional) · backend/evals/
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=
