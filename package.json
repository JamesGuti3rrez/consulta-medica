{
    "name": "consulta-medica-demo",
    "version": "1.0.0",
    "private": true,
    "description": "Simulador de consulta médica con paciente virtual para estudiantes de medicina",
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "setup": "node scripts/python.mjs setup",
        "start": "node scripts/python.mjs start",
        "build": "npm run build:images && npm run build:css",
        "build:css": "npm run build:css:portada && npm run build:css:simulacion",
        "build:css:portada": "tailwindcss -c tailwind.portada.config.cjs -i src/styles/tailwind.css -o public/css/tailwind-portada.css --minify",
        "build:css:simulacion": "tailwindcss -c tailwind.simulacion.config.cjs -i src/styles/tailwind.css -o public/css/tailwind-simulacion.css --minify",
        "watch:css:portada": "tailwindcss -c tailwind.portada.config.cjs -i src/styles/tailwind.css -o public/css/tailwind-portada.css --watch",
        "watch:css:simulacion": "tailwindcss -c tailwind.simulacion.config.cjs -i src/styles/tailwind.css -o public/css/tailwind-simulacion.css --watch",
        "build:images": "node scripts/optimize-images.mjs",
        "build:vendor": "node scripts/copy-vendor.mjs",
        "postinstall": "npm run build:vendor"
    },
    "devDependencies": {
        "@tailwindcss/container-queries": "^0.1.1",
        "@tailwindcss/forms": "^0.5.11",
        "sharp": "^0.35.5",
        "tailwindcss": "^3.4.19"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.117.2"
    }
}
