# Secretos locales
.env
.env.*
!.env.example

# Registros de consultas generados al ejecutar el backend
backend/logs/*
!backend/logs/.gitkeep

# Entornos y dependencias locales
.venv/
backend/.venv/
node_modules/

# Archivos temporales
pdf-context.txt
*.log

# Python
__pycache__/
*.egg-info/

# Archivos generados al ejecutar el proyecto (se crean con npm install y npm run build)
frontend/public/css/tailwind-portada.css
frontend/public/css/tailwind-simulacion.css
frontend/public/vendor/
frontend/public/assets/consulta-1600.webp
frontend/public/assets/consulta-800.webp
frontend/public/assets/og-image.jpg
frontend/public/assets/apple-touch-icon.png
frontend/public/assets/avatars/*.webp

# Vínculo local con Vercel y variables que descarga su CLI
.vercel
.env.local

# Archivos locales de la CLI de Supabase (proyecto enlazado, versión)
supabase/.temp/

# Documentos del curso y entregables: se entregan aparte, no van al repositorio
DOCUMENTOS DEL PROYECTO/
Entregables/
*.docx
*.doc
*.pdf
*.xlsx
*.xls
*.pptx
*.ppt
# Archivos de bloqueo de Office (se crean al abrir un documento)
~$*

# Archivos del sistema operativo y cachés de herramientas
Thumbs.db
desktop.ini
.DS_Store
.pytest_cache/
*.tmp

# Fotos de evidencia de pruebas/: se guardan en el equipo, no en GitHub
pruebas/**/*.png
pruebas/**/*.jpg
pruebas/**/*.jpeg

.vercel
.env.local

